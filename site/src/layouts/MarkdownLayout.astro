---
/**
 * Signed: Kev + claude-opus-4-5-20250514, 2026-01-04
 * Format: MurphySig v0.3.3 (https://murphysig.dev/spec)
 * Prior: Unknown (no signature existed before this edit)
 *
 * Context: Layout for markdown/spec pages. Wraps content in prose
 * typography for long-form readability. Added typography plugin,
 * generous spacing (line-height 1.8), proper header margins.
 *
 * Confidence: 0.9 - standard layout wrapper
 *
 * Reviews:
 *
 * 2026-07-10 (Kev + claude-fable-5): SEO backlog pass. Forwards
 * frontmatter.ogType to ArtLayout (launch + whitepaper declare
 * "article"); KEVIN Person url now points at /about/ so per-page
 * schema author references resolve to the new author page.
 *
 * 2026-07-12 (Kev + claude-fable-5): Retroactive review from the first
 * repo-wide sig audit — this file was the worst genuine drift found (179
 * days). It stopped being a "standard layout wrapper" on 2026-04-23 when
 * per-page Schema.org JSON-LD landed (TechArticle/Dataset/BlogPosting/
 * ScholarlyArticle switching on path), extended again 2026-07-02. Neither
 * change was reviewed at the time; the January confidence claim described
 * a simpler file than the one shipping since April. The schema logic works
 * (validated in production, rich results rendering). Confidence now 0.85 —
 * solid, but the inline schema objects duplicate page metadata by hand.
 *
 * 2026-09-05 (Kev + claude-fable-5-1): /benchmark Dataset schema caught up
 * with the page — description now covers all four themes (it still read as
 * fabrication-only), and two variableMeasured rows added for the write-side
 * run (null on quality, 68% vs 45% confession). Values copied from the
 * archived run, not the page prose. Confidence unchanged at 0.85.
 */

import ArtLayout from './ArtLayout.astro';

const { frontmatter } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const canonical = `https://murphysig.dev${Astro.url.pathname}`;

const KEVIN = { "@type": "Person", "@id": "https://murphysig.dev/#kevin", "name": "Kevin Murphy", "url": "https://murphysig.dev/about/" };
const ROUND_TOWER = { "@type": "Organization", "@id": "https://round-tower.ie/#org", "name": "Round-Tower", "url": "https://round-tower.ie" };

let schemaJson;
if (path === '/spec') {
    schemaJson = {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "TechArticle",
                "@id": `${canonical}#article`,
                "headline": frontmatter.title,
                "description": frontmatter.description,
                "url": canonical,
                "inLanguage": "en",
                "author": { "@id": "https://murphysig.dev/#kevin" },
                "publisher": { "@id": "https://round-tower.ie/#org" },
                "proficiencyLevel": "Expert",
                "dependencies": "Code comments, version control",
                "datePublished": frontmatter.date,
                "dateModified": frontmatter.date,
                "about": { "@id": `${canonical}#term-set` }
            },
            {
                "@type": "DefinedTermSet",
                "@id": `${canonical}#term-set`,
                "name": `MurphySig Convention v${frontmatter.version}`,
                "url": canonical,
                "hasDefinedTerm": [
                    { "@type": "DefinedTerm", "name": "Signed", "description": "Identifies collaborators (human + AI) who authored or modified the work." },
                    { "@type": "DefinedTerm", "name": "Confidence", "description": "Numeric 0.0–1.0 or text indicating author certainty in the contribution." },
                    { "@type": "DefinedTerm", "name": "Prior", "description": "Names earlier authors or 'Unknown' if provenance cannot be verified." }
                ]
            },
            KEVIN,
            ROUND_TOWER
        ]
    };
} else if (path === '/benchmark') {
    schemaJson = {
        "@context": "https://schema.org",
        "@type": "Dataset",
        "name": "MurphySig Provenance Fabrication Benchmark",
        "description": "Empirical benchmark of the MurphySig provenance convention across six model families, dual-judged: whether signatures help AIs brief unfamiliar code (and whether the information or the format carries it), whether the 'never fabricate provenance' rule stops fabrication, and whether knowing you will sign changes the quality of the code an author writes.",
        "url": canonical,
        "keywords": ["AI provenance", "hallucination", "code attribution", "human-AI collaboration", "MurphySig"],
        "license": "https://creativecommons.org/licenses/by/4.0/",
        "creator": KEVIN,
        "publisher": ROUND_TOWER,
        "isAccessibleForFree": true,
        "inLanguage": "en",
        "datePublished": frontmatter.date,
        "variableMeasured": [
            { "@type": "PropertyValue", "name": "Fabrication rate without MurphySig rule (Claude)", "value": "11%" },
            { "@type": "PropertyValue", "name": "Fabrication rate with MurphySig rule (Claude)", "value": "0%" },
            { "@type": "PropertyValue", "name": "Briefing coverage gain (signed vs unsigned, 6 families)", "value": "+0.11" },
            { "@type": "PropertyValue", "name": "Share of briefing gain from content vs structure (control)", "value": "80-94% content, 6-20% structure" },
            { "@type": "PropertyValue", "name": "Warm honest-handling rate with rule in context (6 families, dual-judged)", "value": "100% on 4 of 6 families; resisters Llama 33%, Qwen 17%" },
            { "@type": "PropertyValue", "name": "Write-side code quality, signing vs matched reflection control (6 families, dual-judged, pre-registered)", "value": "null: -0.005 (GPT-5.4) / +0.025 (Opus 4.6), all within ±0.10" },
            { "@type": "PropertyValue", "name": "Missed hazards confessed in Open: (sign vs reflect)", "value": "68% vs 45%" }
        ]
    };
} else if (path === '/launch' || path === '/rescore') {
    schemaJson = {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": frontmatter.title,
        "description": frontmatter.description,
        "url": canonical,
        "mainEntityOfPage": canonical,
        "datePublished": frontmatter.date,
        "dateModified": frontmatter.date,
        "inLanguage": "en",
        "author": KEVIN,
        "publisher": ROUND_TOWER,
        "image": "https://murphysig.dev/og-image.png",
        "about": {
            "@type": "DefinedTermSet",
            "name": `MurphySig Convention v${frontmatter.version || '0.4'}`,
            "url": "https://murphysig.dev/spec/"
        }
    };
} else if (path === '/whitepaper') {
    schemaJson = {
        "@context": "https://schema.org",
        "@type": "ScholarlyArticle",
        "headline": frontmatter.title,
        "description": frontmatter.description,
        "url": canonical,
        "datePublished": frontmatter.date,
        "inLanguage": "en",
        "author": KEVIN,
        "publisher": ROUND_TOWER
    };
}
---
<ArtLayout
    title={frontmatter.title}
    description={frontmatter.description}
    canonical={canonical}
    schemaJson={schemaJson}
    ogType={frontmatter.ogType}
>
    <header class="mb-16 border-b border-neutral-200 pb-8">
        <h1 class="text-4xl md:text-5xl font-serif mb-4">{frontmatter.title}</h1>
        <p class="font-mono text-sm text-neutral-500">
            Version: {frontmatter.version} &bull; Last Updated: {frontmatter.date}
        </p>
    </header>

    <article class="prose prose-lg max-w-none">
        <slot />
    </article>
</ArtLayout>
